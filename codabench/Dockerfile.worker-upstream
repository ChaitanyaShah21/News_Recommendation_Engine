# Run UPSTREAM's compute_worker.py on the runtime upstream actually declares.
#
# Why this exists. Codabench's published worker images are incompatible with
# Codabench's live server in three places:
#   1. the submission secret is echoed back unconverted -> HTTP 500 (cpu1.1) or
#      "Object of type UUID is not JSON serializable" (latest);
#   2. output/ is never created for result-only competitions -> push_output dies
#      on output/metadata, before uploading the prediction result;
#   3. the run-args keys were renamed server-side (`program_data` /
#      `ingestion_program` vs the server's `scoring_program_data` /
#      `ingestion_program_data`), so both program bundles are silently skipped.
#      The released image also never fetches `submission_data` and has no
#      equivalent of upstream's _copy_submission_to_input_res(), so a result-only
#      submission never reaches the scoring program. A missing code path, not a
#      rename -- which is where back-porting stopped being sensible.
#
# Everything below is read off upstream rather than guessed:
#   - compute_worker/pyproject.toml  -> requires-python ==3.13.11, and the exact
#     pinned dependency set. (An earlier draft of this file guessed 3.10 and a
#     hand-derived dependency list; the manifest is authoritative.)
#   - compute_worker.py:263 does app.config_from_object("celery_config"), so
#     celery_config.py is required, not optional.
#   - logs_loguru lives at src/settings/logs_loguru.py, NOT beside compute_worker.py.
#
# The build-time import check is the design point: an import failure costs
# nothing, whereas every earlier approach had to claim a real submission off the
# shared queue to learn anything at all.

FROM python:3.13-slim

# Exactly compute_worker/pyproject.toml's dependencies.
RUN pip install --no-cache-dir \
        "celery==5.6.2" \
        "requests>=2.32.4,<3" \
        "watchdog==6.0.0" \
        "argh==0.31.3" \
        "websockets==16.0.0" \
        "aiofiles==25.1.0" \
        "pyyaml==6.0.3" \
        "loguru>=0.7.3,<0.8" \
        "docker>=7.1.0,<8" \
        "rich>=14.2.0,<15" \
        "setuptools>=82.0.0"

ARG UPSTREAM=https://raw.githubusercontent.com/codalab/codabench/develop
ADD ${UPSTREAM}/compute_worker/compute_worker.py  /compute_worker.py
ADD ${UPSTREAM}/compute_worker/celery_config.py   /celery_config.py
ADD ${UPSTREAM}/src/settings/logs_loguru.py       /logs_loguru.py

# ADD-from-URL writes 0600; the worker does not run as the build user in every
# context, so make them readable.
RUN chmod 0644 /compute_worker.py /celery_config.py /logs_loguru.py

# NO build-time import check. compute_worker.py calls docker.from_env() at module
# import (the "Using DOCKER without GPU capabilities" line), and `docker build` has
# no Docker socket, so importing it during the build can only ever fail. Run the
# check at RUN time with the socket mounted instead -- see README notes; it is
# still free, because an import failure happens long before the worker connects to
# the queue or claims a submission:
#
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
#       --env-file /codabench/.env worker-upstream \
#       "python -c 'import compute_worker; print(\"IMPORT OK\")'"

# Same entrypoint/command as the released image.
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["celery -A compute_worker worker -l info -Q compute-worker -n compute-worker@$HOSTNAME --concurrency=1"]
